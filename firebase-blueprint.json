{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user roles and profile data",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["dependent", "caregiver"] },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "object" }
      },
      "required": ["role", "name", "email"]
    },
    "Memory": {
      "title": "Episodic Memory",
      "description": "Stores memories and logs for a dependent",
      "type": "object",
      "properties": {
        "dependentId": { "type": "string", "maxLength": 128 },
        "content": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "enum": ["medical", "routine", "alert", "preference"] },
        "timestamp": { "type": "number" }
      },
      "required": ["dependentId", "content", "category", "timestamp"]
    },
    "Telemetry": {
      "title": "Telemetry Summary",
      "description": "Aggregated session latency and health metrics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "channelName": { "type": "string", "maxLength": 128 },
        "turnsCount": { "type": "number" },
        "avgLatencyMs": { "type": "number" },
        "maxLatencyMs": { "type": "number" },
        "bargeInCount": { "type": "number" },
        "voiceprintMatchPct": { "type": "number" },
        "startedAt": { "type": "number" },
        "endedAt": { "type": "number" },
        "createdAt": { "type": "object" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "memories/{memoryId}": {
      "schema": { "$ref": "#/entities/Memory" },
      "description": "Episodic memories"
    },
    "telemetry/{telemetryId}": {
      "schema": { "$ref": "#/entities/Telemetry" },
      "description": "Session telemetry and latency metrics"
    }
  }
}
