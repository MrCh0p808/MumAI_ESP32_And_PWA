rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return (!('role' in data) || (data.role is string && data.role in ['dependent', 'caregiver']))
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('voiceprintUrl' in data) || (data.voiceprintUrl is string && data.voiceprintUrl.size() <= 500))
        && (!('hasVoiceprint' in data) || data.hasVoiceprint is bool)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSignedIn(); // Caregivers need to read dependent info, etc.
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'email', 'voiceprintUrl', 'hasVoiceprint', 'createdAt']);
    }

    function isValidMemory(data) {
      return data.keys().hasAll(['dependentId', 'content', 'category', 'timestamp'])
        && data.dependentId is string && data.dependentId.size() <= 128
        && data.content is string && data.content.size() <= 1000
        && data.category is string && data.category in ['medical', 'routine', 'alert', 'preference']
        && data.timestamp is number;
    }

    match /memories/{memoryId} {
      allow get, list: if isSignedIn(); // Both dependent and caregiver can read
      allow create: if isSignedIn() && isValidMemory(incoming())
                     && exists(/databases/$(database)/documents/users/$(incoming().dependentId));
      allow update: if false; // Logs are immutable
      allow delete: if false;
    }

    function isValidTelemetry(data) {
      return (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('channelName' in data) || (data.channelName is string && data.channelName.size() <= 128))
        && (!('turnsCount' in data) || data.turnsCount is number)
        && (!('avgLatencyMs' in data) || data.avgLatencyMs is number)
        && (!('maxLatencyMs' in data) || data.maxLatencyMs is number)
        && (!('bargeInCount' in data) || data.bargeInCount is number)
        && (!('voiceprintMatchPct' in data) || data.voiceprintMatchPct is number)
        && (!('startedAt' in data) || data.startedAt is number)
        && (!('endedAt' in data) || data.endedAt is number)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /telemetry/{telemetryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidTelemetry(incoming());
      allow update, delete: if false; // Telemetry metrics are immutable
    }
  }
}
