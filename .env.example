# ------------------------------------------------------------------------------
# FRONTEND VARIABLES
# ------------------------------------------------------------------------------
# Must start with VITE_ to be accessible in the React client.

VITE_AGORA_APP_ID=

# ------------------------------------------------------------------------------
# BACKEND SECRETS (server.ts)
# ------------------------------------------------------------------------------
# Never expose these to the browser or commit them to version control.

# Agora Project Credentials (for minting RTC & RTM tokens)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Agora REST API Credentials (for spawning the Conversational AI Agent)
# Retrieve from: Agora Console -> Profile -> RESTful API
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ------------------------------------------------------------------------------
# OPTIONAL / FUTURE INTEGRATIONS
# ------------------------------------------------------------------------------
# Currently using Firebase (firebase-applet-config.json) for Database & Auth.

# Agora Webhook Secret for Tool Calling (Phase 2)
AGORA_WEBHOOK_SECRET=

# Sarvam AI API Key (for authentic maternal Indian Hindi/Hinglish TTS via bulbul:v1)
SARVAM_API_KEY=

# Agora Speaker Lock (Zero-key SAL mode is enabled by default with no keys needed).
# Optional: Pre-hosted 16kHz 16-bit mono PCM sample URL if using named speaker recognition mode.
AGORA_VOICEPRINT_SAMPLE_URL=

# Gemini API Key (for server-side generative logic)
GEMINI_API_KEY=
